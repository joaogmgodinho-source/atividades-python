/*
 Exercício 1 — Boas-vindas
 Aluno: João Gustavo
 Objetivo: Leia o nome do aluno e mostre a mensagem: Olá, <nome>! Bem-vindo(a) ao curso de
Desenvolvimento de Sistemas.
*/
programa {
  funcao inicio() {

    // criando a variavel nome tipo cadeia
   cadeia nome

    // pede para digitar o nome do usuario 
   escreva("Digite seu nome: ")
   leia(nome)

    // Mostra a frase junto com o nome do usuario 
   escreva("Olá, ", nome, "! Bem-vindo ao curso de Desenvolvimento de Sistemas")

  }
}
